<mxfile host="app.diagrams.net">
  <diagram id="calltree" name="call-tree">
    <mxGraphModel dx="1200" dy="900" grid="0" page="1" pageWidth="1240" pageHeight="1240">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>

        <mxCell id="title" value="Vector-merge read-forcing call tree — measured 15.86M-ordinal 4-way merge, 2026-08-26 10:51-13:05 UTC (133.7 min wall)" style="text;html=1;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1200" height="30" as="geometry"/></mxCell>
        <mxCell id="legend" value="RED = cold random device reads (forced) &#160;&#160;ORANGE = logical reads, mostly page-cache warm &#160;&#160;GREEN = sequential IO &#160;&#160;GRAY = CPU / RAM only" style="text;html=1;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="38" width="1200" height="20" as="geometry"/></mxCell>

        <mxCell id="compact" value="compact() — 1 merge&#10;15,864,348 ordinals, 4 sources (~3.97M each), dim=384, degree=32" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=1" vertex="1" parent="1"><mxGeometry x="360" y="70" width="420" height="46" as="geometry"/></mxCell>

        <mxCell id="pretouch" value="pretouchSources()&#10;all 4 sources sequentially: 15.86M x 4.88 KB = 77 GB&#10;33 s (0.4% wall) — self-evicting: 2.1x the 36 GiB cache" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11" vertex="1" parent="1"><mxGeometry x="40" y="150" width="340" height="60" as="geometry"/></mxCell>
        <mxCell id="pq" value="PQRetrainer&#10;128k sampled vectors, extract + refine&#10;15 s idle-device / 40 min when co-starved (63.6M)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11" vertex="1" parent="1"><mxGeometry x="40" y="222" width="340" height="60" as="geometry"/></mxCell>
        <mxCell id="ords" value="buildSimilarityOrdinalMappers&#10;15.86M nodes, 166 s = 10.5 us/node (2.1% wall)&#10;reads ride the pretouch-warm pages" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11" vertex="1" parent="1"><mxGeometry x="40" y="294" width="340" height="60" as="geometry"/></mxCell>

        <mxCell id="l0" value="compactLevels — LEVEL 0 (base layer)&#10;109.6 min = 82% OF WALL — THE COST CENTER&#10;source groups smallest-to-largest, drain barrier between groups&#10;group walls: 63 / 35 / 22 / 9.5 min for 3 / 2 / 1 / 0 searches-per-node" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1" vertex="1" parent="1"><mxGeometry x="360" y="150" width="420" height="84" as="geometry"/></mxCell>

        <mxCell id="upper" value="upper layers 1-3&#10;~2.5% of nodes, same search shape&#10;16 min (12% wall, confounded by co-merge)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11" vertex="1" parent="1"><mxGeometry x="820" y="150" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="wb" value="Cassandra write-back&#10;effectiveRemappers read-back + TERMS_DATA in place&#10;1.8 min sequential (1.3% wall), 19.35 GB out" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11" vertex="1" parent="1"><mxGeometry x="820" y="222" width="300" height="60" as="geometry"/></mxCell>

        <mxCell id="pbn" value="processBaseNode — x 15.86M nodes&#10;(retained-only fast path: only 1% of nodes qualify)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1" vertex="1" parent="1"><mxGeometry x="380" y="270" width="380" height="46" as="geometry"/></mxCell>

        <mxCell id="own" value="own record read: getVectorInto(node)&#10;x 15.86M — batch-prefetched when ordinal range dense" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11" vertex="1" parent="1"><mxGeometry x="60" y="350" width="320" height="50" as="geometry"/></mxCell>

        <mxCell id="gc" value="gatherCandidates — x 15.86M" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1" vertex="1" parent="1"><mxGeometry x="440" y="350" width="260" height="36" as="geometry"/></mxCell>

        <mxCell id="same" value="gatherFromSameSource — x1 per node&#10;32 neighbors: willNeed hint burst, then 32 vector reads&#10;~508M logical reads, adjacency-local + hinted = mostly warm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11" vertex="1" parent="1"><mxGeometry x="60" y="420" width="360" height="64" as="geometry"/></mxCell>

        <mxCell id="other" value="gatherFromOtherSource — x (3 - sizeRank) per node&#10;only into LARGER sources; smaller arrive via reverse offers&#10;= 23.8M full graph searches (avg 1.5/node)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1" vertex="1" parent="1"><mxGeometry x="450" y="420" width="380" height="64" as="geometry"/></mxCell>

        <mxCell id="rev" value="reverseCandidates&#10;191.6M offers, RAM ring&#10;(replaces searches into smaller sources)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11" vertex="1" parent="1"><mxGeometry x="860" y="420" width="260" height="64" as="geometry"/></mxCell>

        <mxCell id="search" value="GraphSearcher.search — x 23.8M&#10;cold entry: full hierarchy descent, then searchOneLayer L0&#10;topK = 32, rerankK = 32, no seeding (fused path)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1" vertex="1" parent="1"><mxGeometry x="450" y="516" width="380" height="64" as="geometry"/></mxCell>

        <mxCell id="expand" value="EXPANSION — x ~60-80 per search, DATA-DEPENDENT CHAIN&#10;getPackedNeighbors -&gt; PackedNeighbors.readInto -&gt; readFully&#10;1 fused record = adjacency (136 B) + 32 neighbor PQ codes (~3.2 KB)&#10;~1.8B record reads x 4.88 KB record = ~7 TB through a 36 GiB cache&#10;= 63% of RUNNABLE samples — THE DOMINANT DEVICE LOAD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1" vertex="1" parent="1"><mxGeometry x="400" y="612" width="480" height="100" as="geometry"/></mxCell>

        <mxCell id="adc" value="ADC-score all 32 neighbors&#10;from packed codes — zero extra IO&#10;(the point of the fused layout)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11" vertex="1" parent="1"><mxGeometry x="60" y="612" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="frontier" value="FrontierPrefetchingView&#10;hint top-WIDTH=3 of shadow queue, willNeed fadvise&#10;24% of RUNNABLE samples issuing hints; reads still block" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11" vertex="1" parent="1"><mxGeometry x="60" y="686" width="300" height="64" as="geometry"/></mxCell>

        <mxCell id="rescore" value="rescore top-32 results — x 762M logical&#10;getVectorInto: exact 1536 B vector read + compare&#10;mostly warm (top results were just expanded) = 12% of samples" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11" vertex="1" parent="1"><mxGeometry x="450" y="740" width="380" height="64" as="geometry"/></mxCell>

        <mxCell id="div" value="retainDiverse — x 15.86M&#10;up to 144 candidate vector re-reads + O(sel^2) compares&#10;pages just faulted by search/rescore = ~all warm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11" vertex="1" parent="1"><mxGeometry x="450" y="836" width="380" height="60" as="geometry"/></mxCell>
        <mxCell id="write" value="writeInlineNodeRecord — x 15.86M&#10;positional write, disjoint ranges, admission-paced&#10;19.35 GB total output (sequential-ish)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11" vertex="1" parent="1"><mxGeometry x="450" y="920" width="380" height="60" as="geometry"/></mxCell>

