<mxfile host="app.diagrams.net">
  <diagram id="latgap" name="latency-gap">
    <mxGraphModel dx="1200" dy="900" grid="0" page="1" pageWidth="1240" pageHeight="760">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="Why the reads cannot be hidden — the data-dependent chain vs a 3-deep hint" style="text;html=1;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1100" height="30" as="geometry"/></mxCell>

        <mxCell id="lane" value="ONE search on one worker thread (repeat ~60-80x per search, 23.8M searches per merge)" style="text;html=1;fontSize=12;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="800" height="22" as="geometry"/></mxCell>

        <mxCell id="s1" value="pop best&#10;candidate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11" vertex="1" parent="1"><mxGeometry x="40" y="82" width="90" height="44" as="geometry"/></mxCell>
        <mxCell id="s2" value="readFully: packed row of THAT node&#10;~100 us cold device read — THREAD BLOCKED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1" vertex="1" parent="1"><mxGeometry x="160" y="82" width="280" height="44" as="geometry"/></mxCell>
        <mxCell id="s3" value="ADC-score 32&#10;neighbors (~us)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11" vertex="1" parent="1"><mxGeometry x="470" y="82" width="110" height="44" as="geometry"/></mxCell>
        <mxCell id="s4" value="push into queue;&#10;NEXT TARGET NOW KNOWN&#10;(not before)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11" vertex="1" parent="1"><mxGeometry x="610" y="82" width="160" height="44" as="geometry"/></mxCell>
        <mxCell id="s5" value="hint top-3 of shadow queue&#10;(WIDTH=3 fadvise, async)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11" vertex="1" parent="1"><mxGeometry x="800" y="82" width="180" height="44" as="geometry"/></mxCell>

        <mxCell id="se1" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="se2" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="se3" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="se4" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="se5" style="edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;entryX=0.5;entryY=1;curved=1;dashed=1" edge="1" parent="1" source="s5" target="s1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="500" y="160"/></Array></mxGeometry></mxCell>

        <mxCell id="gap" value="THE GAP: a hint only helps if the hinted node is actually expanded ~1 device-latency later AND survives queue churn. At high miss rate the beam reorders every expansion; 3 hints cover the next ~1-2 expansions at best. Every uncovered pop = one full stall. Measured: 63% of runnable samples blocked in readFully WITH hints active." style="whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;spacing=6;fontSize=12" vertex="1" parent="1"><mxGeometry x="40" y="190" width="1100" height="70" as="geometry"/></mxCell>

        <mxCell id="agg" value="AGGREGATE VIEW — parallelism comes ONLY from co-running searches, never from within one search" style="text;html=1;fontSize=12;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="286" width="900" height="22" as="geometry"/></mxCell>

        <mxCell id="w1" value="~37-40 FJP workers x ~1 outstanding cold read each&#10;(+ a few async hints in flight)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12" vertex="1" parent="1"><mxGeometry x="40" y="318" width="330" height="56" as="geometry"/></mxCell>
        <mxCell id="w2" value="device: ~200k r/s @ 4-6 KB = 1.2 GB/s&#10;100% util, iowait 40% — SATURATED BY LATENCY-BOUND SMALL READS, not bandwidth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1" vertex="1" parent="1"><mxGeometry x="430" y="318" width="420" height="56" as="geometry"/></mxCell>
        <mxCell id="w3" value="cache: 36 GiB file cap vs ~77 GB (16M class) to ~310 GB (63.6M class) source set&#10;=&gt; expansion miss probability ~0.5-0.9 and rising with merge size" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12" vertex="1" parent="1"><mxGeometry x="890" y="318" width="310" height="70" as="geometry"/></mxCell>
        <mxCell id="we1" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="w1" target="w2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="we2" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="w2" target="w3"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="lever" value="Levers, in the order they attack the 63%:&#10;1. FEWER SEARCHES — shape/policy (retain-largest: shape-defeated under STCS(4) equal sources; cross-link already halves searches to avg (k-1)/2)&#10;2. FEWER COLD READS PER SEARCH — cache capacity (MemoryHigh), locality (similarity ordinals: DONE), smaller records per expansion&#10;3. HIDE THE LATENCY — frontierPrefetch WIDTH sweep (3 -&gt; 8/16/32), deeper queue per thread; hints are free-ish, stalls are 100 us&#10;4. CHEAPER PER-VISIT SCORING — O-track (O4 codebook adoption / O1 decoder sharing / O7 same-source ADC) trims CPU + rescore/same-source reads, NOT the expansion read itself" style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;spacing=6;fontSize=12" vertex="1" parent="1"><mxGeometry x="40" y="420" width="1160" height="120" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
