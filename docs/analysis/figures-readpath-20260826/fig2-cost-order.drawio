        <mxCell id="p3" value="PANEL C — logical reads vs device reads per merge class (the cache does the eliding)" style="text;html=1;fontSize=13;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="472" width="900" height="24" as="geometry"/></mxCell>

        <mxCell id="tbl" value="call path (per 15.86M merge)&#10;-----------------------------------------------&#10;expansion packed-row reads: ~1.8B logical, ~4.9 KB each = ~7 TB -&gt; ~ALL COLD above RAM (source set 2.1x the 36 GiB cache; miss rate ~0.5-0.9)&#10;rescore vector reads: 762M logical -&gt; mostly WARM (top-K were just expanded)&#10;same-source neighbor reads: 508M logical -&gt; WARM (hinted burst + similarity-local)&#10;diversity re-reads: up to 2.3B logical -&gt; ~ALL WARM (faulted moments before)&#10;own-record batch prefetch: 15.86M sequential -&gt; GREEN&#10;pretouch: 15.86M sequential (77 GB) -&gt; GREEN but SELF-EVICTING at 2.1x cache&#10;output: 19.35 GB positional writes -&gt; GREEN" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;spacingLeft=10;spacing=6;fontSize=12;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="40" y="504" width="1100" height="230" as="geometry"/></mxCell>

        <mxCell id="check" value="Consistency check: base layer 109.6 min x ~1.1 GB/s device read = ~7.2 TB observed ~= 23.8M searches x ~70 cold expansions x 4.88 KB = ~7 TB predicted. The model closes." style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;fontSize=12;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="756" width="1100" height="46" as="geometry"/></mxCell>
