        <mxCell id="b2" value="issuing willNeed hints (frontier + seed + same-source): 24%" style="whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;fontSize=12" vertex="1" parent="1"><mxGeometry x="40" y="348" width="288" height="30" as="geometry"/></mxCell>
